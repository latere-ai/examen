# The core's settings at Latere; every EXAMEN_* variable is in the core's
# configuration table (examen specs/011-distribution.md). The database URLs
# and the authorizer's bearer are Secrets, each named in deployment.yaml,
# and the issuer and the audience the container's own env; none of them is
# here.
#
# The origin serves the core under /v1/evals; the core serves its API under
# that base path in the place of its own /v1, so the Ingress does not
# rewrite.
EXAMEN_BASE_PATH=/v1/evals
# Every request, and every step of an experiment's unattended work, is
# decided by platformd's Examen decider on its internal TLS listener; the
# bearer is the file the Secret examen-authorizer is mounted as.
EXAMEN_AUTHORIZER_URL=https://platformd-internal.latere.svc.cluster.local/internal/examen/authorize
EXAMEN_AUTHORIZER_TOKEN_FILE=/var/run/examen-authorizer/token
# The key source, on the same listener: each experiment of external
# candidates gets one model Key from platformd, handed out with every lease
# of its runs, and the records of its calls are read through it. The
# bearer is the file the Secret examen-keys is mounted as.
EXAMEN_KEYS_URL=https://platformd-internal.latere.svc.cluster.local/internal/examen/keys
EXAMEN_KEYS_TOKEN_FILE=/var/run/examen-keys/token
# The minter, on the same listener: owner tokens for an experiment's
# unattended work, minted from the sign-in its starter kept for it (spec
# 214, "Owner tokens"). The bearer is the file the Secret examen-minter is
# mounted as.
EXAMEN_MINTER_URL=https://platformd-internal.latere.svc.cluster.local/internal/examen/tokens
EXAMEN_MINTER_TOKEN_FILE=/var/run/examen-minter/token
# Topos at the origin, where each trial of an Agent candidate is one
# unattended session created as the experiment's owner, and Origo, the
# root a task's repository is cloned from by that session. Both are reached
# through the ingress, as the NetworkPolicy allows.
EXAMEN_TOPOS_URL=https://api.latere.ai/v1/agents
EXAMEN_ORIGO_URL=https://code.latere.ai
# What grades an Agent candidate's runs, each core at the origin through the
# ingress the NetworkPolicy already allows: Cella, where each run's checks
# run in a sandbox created as the owner with the network off, in the
# control plane's default environment from its default image; Storage,
# where the files a run's session kept and a check's own files are read as
# the owner; and Models, whose native door a model judge calls on a Key the
# key source leases for that judge. Every link read of Storage answers as a
# download (Arca v0.9.1), which the Storage address is set beside. No event
# sink.
EXAMEN_CELLA_URL=https://api.latere.ai/v1/environments
EXAMEN_CELLA_ENVIRONMENT=default
EXAMEN_ARCA_URL=https://api.latere.ai/v1/storage
EXAMEN_FILESTORE_DOWNLOAD_ONLY=true
EXAMEN_LUX_URL=https://api.latere.ai/v1/models
